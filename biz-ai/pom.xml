<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>axzl</artifactId>
        <groupId>com.axzl</groupId>
        <version>3.9.1</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>biz-ai</artifactId>

    <description>
        AI服务模块（RAG流程+文档处理）
    </description>

    <dependencies>

        <!-- 通用工具-->
        <dependency>
            <groupId>com.axzl</groupId>
            <artifactId>axzl-common</artifactId>
        </dependency>

        <!-- 知识库模块 -->
        <dependency>
            <groupId>com.axzl</groupId>
            <artifactId>biz-knowledge</artifactId>
        </dependency>

        <!-- 问诊会话模块 -->
        <dependency>
            <groupId>com.axzl</groupId>
            <artifactId>biz-consultation</artifactId>
        </dependency>

        <!-- 用户档案模块 -->
        <dependency>
            <groupId>com.axzl</groupId>
            <artifactId>biz-profile</artifactId>
        </dependency>

        <!-- Spring AI OpenAI Model Starter (DeepSeek Chat + DashScope Embedding) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- Spring AI Milvus Vector Store Starter -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-milvus</artifactId>
        </dependency>

        <!-- PDFBox -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
        </dependency>

        <!-- Apache POI (Word文档解析) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>

        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
